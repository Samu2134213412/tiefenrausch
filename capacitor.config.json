{
  "appId": "de.tiefenrausch.spiel",
  "appName": "Tiefenrausch",
  "webDir": "www",
  "android": {
    "backgroundColor": "#04101f",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
